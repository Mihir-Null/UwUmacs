(ert-deftest uwumacs-registry-late-hook-invalid-map-never-publishes-new-readiness ()
  (uwumacs-registry-test-with-registry
    (let ((cleanups 0) (snapshot uwumacs--buffer-leader-map))
      (uwumacs-register-integration 'two)
      (uwumacs-register-integration 'one :setup (lambda () (lambda () (cl-incf cleanups))))
      (setq snapshot uwumacs--buffer-leader-map)
      (add-hook 'uwumacs-after-integration-hook
                (lambda (id) (when (eq id 'two)
                               (keymap-set uwumacs-user-leader-map "m" #'ignore))))
      (setq uwumacs-integrations '(one two))
      (uwumacs-refresh)
      (should (eq 'failed (uwumacs-registry-test-status 'one)))
      (should (eq 'failed (uwumacs-registry-test-status 'two)))
      (should (= cleanups 1))
      (should (eq snapshot uwumacs--buffer-leader-map))
      ;; The registry must not roll back a direct mutation of the user's map.
      (should (eq 'ignore (keymap-lookup uwumacs-user-leader-map "m")))
      (keymap-unset uwumacs-user-leader-map "m"))))

(ert-deftest uwumacs-registry-selected-order-precedes-registration-order ()
  (uwumacs-registry-test-with-registry
    (let (events)
      (uwumacs-register-integration 'one :setup (lambda () (push 'one events) nil))
      (uwumacs-register-integration 'two :setup (lambda () (push 'two events) nil))
      (setq uwumacs-integrations '(one two))
      (uwumacs-refresh)
      (should (equal '(two one) events)))))

(ert-deftest uwumacs-registry-callback-mutations-fail-without-nested-commit ()
  (dolist (operation '(disable enable register))
    (uwumacs-registry-test-with-registry
      (let ((setups 0) (cleanups 0))
        (uwumacs-register-integration 'other :leader-bindings '(("y" forward-char "Other")))
        (uwumacs-register-integration 'one :leader-bindings '(("z" ignore "One"))
          :setup (lambda () (cl-incf setups) (lambda () (cl-incf cleanups))))
        (let ((original (copy-tree (uwumacs--descriptor 'other))))
          (add-hook 'uwumacs-after-integration-hook
                    (lambda (id)
                      (when (eq id 'one)
                        (pcase operation
                          ('disable (uwumacs-disable-integration id))
                          ('enable (uwumacs-enable-integration 'other))
                          ('register (uwumacs-register-integration 'other
                                       :leader-bindings '(("q" backward-char "Changed"))))))))
          (should (eq 'failed (uwumacs-enable-integration 'one)))
          (should (equal uwumacs-integrations '(one)))
          (should (equal original (uwumacs--descriptor 'other)))
          (should (eq 'disabled (uwumacs-registry-test-status 'other)))
          (should (string-match-p "registry callback" (plist-get (alist-get 'one uwumacs--registry) :reason)))
          (should-not (keymap-lookup uwumacs--buffer-leader-map "z"))
          (should-not (keymap-lookup uwumacs--buffer-leader-map "y"))
          (dotimes (_ 3) (uwumacs-refresh))
          (should (equal uwumacs-integrations '(one)))
          (should (eq 'failed (uwumacs-registry-test-status 'one)))
          (should (= setups 1))
          (should (= cleanups 1))
          ;; Explicit disable/re-enable remains a supported retry boundary.
          (setq uwumacs-after-integration-hook nil)
          (uwumacs-disable-integration 'one)
          (should (eq 'ready (uwumacs-enable-integration 'one)))
          (should (= setups 2))
          (should (= cleanups 1)))))))

