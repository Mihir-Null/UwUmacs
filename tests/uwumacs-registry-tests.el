(ert-deftest uwumacs-registry-buffer-refresh-preserves-unselected-buffer-snapshot ()
  (uwumacs-registry-test-with-registry
    (let ((one (generate-new-buffer " uwu-refresh-one"))
          (two (generate-new-buffer " uwu-refresh-two")))
      (unwind-protect
