;;; uwumacs-registry-tests.el --- Registry behavior -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'meow)
(require 'uwumacs)

(defmacro uwumacs-registry-test-with-registry (&rest body)
  (declare (indent 0))
  `(let ((uwumacs--registry nil)
         (uwumacs-integrations nil)
         (uwumacs-after-integration-hook nil)
         (uwumacs-map-context-function nil)
         (uwumacs-user-leader-map (make-sparse-keymap))
         (uwumacs-user-state-maps nil)
         (uwumacs-registry-test-frames (frame-list))
         (uwumacs-registry-test-frame (selected-frame)))
     (should (fboundp 'uwumacs-register-integration))
     (unwind-protect (progn (uwumacs-mode 1) ,@body)
       (uwumacs-mode -1)
       (when (frame-live-p uwumacs-registry-test-frame)
         (select-frame uwumacs-registry-test-frame))
       (dolist (frame (seq-difference (frame-list) uwumacs-registry-test-frames))
         (when (frame-live-p frame) (delete-frame frame t))))))

(defun uwumacs-registry-test-status (id)
  (plist-get (cdr (assq id uwumacs--registry)) :status))

(define-derived-mode uwumacs-registry-parent-mode fundamental-mode "UwuParent")
(define-derived-mode uwumacs-registry-child-mode uwumacs-registry-parent-mode "UwuChild")

(ert-deftest uwumacs-registry-validates-exact-descriptor-data ()
  (uwumacs-registry-test-with-registry
    (dolist (spec '((:priority 3) (:features "bad") (:modes (nil))
                    (:requires (4)) (:features nil :features nil)
                    (:initial-state beacon) (:setup 2) (:capability 3)
                    (:leader-bindings (([120] ignore "x")))
                    (:local-bindings (("x" ignore 7)))
                    (:state-bindings ((insert "j" next-line)))
                    (:leader-bindings (("x" nil "x")))))
      (should-error (apply #'uwumacs-register-integration 'bad spec)))
    (should-not uwumacs--registry)
    (should (eq 'fine (uwumacs-register-integration 'fine :features '(files))))))

(ert-deftest uwumacs-registry-cycle-and-disabled-dependencies ()
  (uwumacs-registry-test-with-registry
    (uwumacs-register-integration 'a :requires '(b))
    (should-error (uwumacs-register-integration 'b :requires '(a)))
    (should-not (assq 'b uwumacs--registry))
    (uwumacs-register-integration 'b)
    (should (eq 'unavailable (uwumacs-enable-integration 'a)))
    (should-not (memq 'b uwumacs-integrations))
    (should (string-match-p "b" (plist-get (cdr (assq 'a uwumacs--registry)) :reason)))
    (uwumacs-enable-integration 'b)
    (should (eq 'ready (uwumacs-registry-test-status 'a)))
    (should-error (uwumacs-disable-integration 'b))
    (uwumacs-disable-integration 'a)
    (uwumacs-disable-integration 'b)))

(ert-deftest uwumacs-registry-setup-cleanup-reload-and-mode-lifetime ()
  (uwumacs-registry-test-with-registry
    (let* ((setups 0) (cleanups 0)
           (setup (lambda () (cl-incf setups) (lambda () (cl-incf cleanups)))))
      (uwumacs-register-integration 'one :setup setup)
      (dotimes (_ 2) (uwumacs-enable-integration 'one))
      (uwumacs-register-integration 'one :setup setup)
      (uwumacs-refresh)
      (should (= setups 1))
      (dotimes (_ 2) (uwumacs-disable-integration 'one))
      (should (= cleanups 1))
      (uwumacs-enable-integration 'one)
      (uwumacs-mode -1)
      (should (= cleanups 2))
      (should-not uwumacs-map-context-function)
      (should-not (memq #'uwumacs--registry-after-load after-load-functions))
      (uwumacs-mode 1)
      (should (= setups 3)))))

(ert-deftest uwumacs-registry-missing-library-capability-and-command ()
  (uwumacs-registry-test-with-registry
    (uwumacs-register-integration 'absent :features '(uwumacs-no-such-library))
    (should (eq 'unavailable (uwumacs-enable-integration 'absent)))
    (uwumacs-register-integration 'cap :capability (lambda () "missing fixture executable"))
    (should (eq 'unavailable (uwumacs-enable-integration 'cap)))
    (uwumacs-register-integration 'command :leader-bindings '(("z" uwumacs-missing-command "Missing")))
    (should (eq 'pending (uwumacs-enable-integration 'command)))
    (should-not (keymap-lookup uwumacs--buffer-leader-map "z"))
    (should (string-match-p "uwumacs-missing-command" (plist-get (cdr (assq 'command uwumacs--registry)) :reason)))
    (uwumacs-doctor)
    (with-current-buffer "*UwUmacs Doctor*"
      (should (string-match-p "missing fixture executable" (buffer-string))))))

(ert-deftest uwumacs-registry-pending-autoload-and-disable-before-load ()
  (uwumacs-registry-test-with-registry
    (let* ((directory (make-temp-file "uwu-lazy-" t))
           (load-path (cons directory load-path)) (calls 0)
           (file (expand-file-name "uwumacs-lazy-fixture.el" directory)))
      (unwind-protect
          (progn
            (with-temp-file file
              (insert ";;; -*- lexical-binding: t; -*-\n(defun uwumacs-lazy-command () (interactive))\n(provide 'uwumacs-lazy-fixture)\n"))
            (autoload 'uwumacs-lazy-command "uwumacs-lazy-fixture" nil t)
            (uwumacs-register-integration 'lazy :features '(uwumacs-lazy-fixture)
              :leader-bindings '(("z" uwumacs-lazy-command "Lazy"))
              :setup (lambda () (cl-incf calls) nil))
            (should (eq 'pending (uwumacs-enable-integration 'lazy)))
            (should-not (featurep 'uwumacs-lazy-fixture))
            (should (eq 'uwumacs-lazy-command (keymap-lookup uwumacs--buffer-leader-map "z")))
            (uwumacs-disable-integration 'lazy)
            (load file nil t)
            (should (eq 'disabled (uwumacs-registry-test-status 'lazy)))
            (should (= calls 0))
            (should (eq 'ready (uwumacs-enable-integration 'lazy)))
            (should (= calls 1)))
        (uwumacs-disable-integration 'lazy)
        (when (featurep 'uwumacs-lazy-fixture) (unload-feature 'uwumacs-lazy-fixture t))
        (fmakunbound 'uwumacs-lazy-command)
        (delete-directory directory t)))))

(ert-deftest uwumacs-registry-mode-entry-setup-and-initial-state-once ()
  (uwumacs-registry-test-with-registry
    (let ((calls 0))
      (uwumacs-register-integration 'parent :modes '(uwumacs-registry-parent-mode)
        :initial-state 'motion :setup (lambda () (cl-incf calls) nil)
        :local-bindings '(("x" ignore "X")))
      (should (eq 'pending (uwumacs-enable-integration 'parent)))
      (with-temp-buffer
        (meow-mode 1)
        (uwumacs-registry-child-mode)
        (meow-mode 1)
        (uwumacs--registry-context-entry)
        (should (eq 'ready (uwumacs-registry-test-status 'parent)))
        (should (eq 'ignore (keymap-lookup (uwumacs-localleader-map) "x")))
        (should (bound-and-true-p meow-motion-mode))
        (meow-insert-mode 1)
        (dotimes (_ 3) (uwumacs-refresh))
        (should (bound-and-true-p meow-insert-mode)))
      (with-temp-buffer (uwumacs-registry-child-mode))
      (should (= calls 1)))))

(ert-deftest uwumacs-registry-specificity-user-overrides-and-committed-metadata ()
  (uwumacs-registry-test-with-registry
    (with-temp-buffer
      (uwumacs-registry-child-mode)
      (uwumacs-register-integration 'parent :modes '(uwumacs-registry-parent-mode)
        :local-bindings '(("x" ignore "Parent") ("p" backward-char "Inherited")))
      (uwumacs-register-integration 'child :modes '(uwumacs-registry-child-mode)
        :local-bindings '(("x" forward-char "Child")))
      (uwumacs-enable-integration 'parent)
      (uwumacs-enable-integration 'child)
      (should (eq 'forward-char (keymap-lookup (uwumacs-localleader-map) "x")))
      (should (eq 'backward-char (keymap-lookup (uwumacs-localleader-map) "p")))
      (dotimes (_ 3) (uwumacs-refresh))
      (should (eq 'child (plist-get (uwumacs--binding-metadata "x" (plist-get uwumacs--buffer-metadata :localleader)) :owner)))
      (keymap-set uwumacs-localleader-map "x" #'beginning-of-line)
      (uwumacs-refresh)
      (should (eq 'beginning-of-line (keymap-lookup (uwumacs-localleader-map) "x"))))))

(ert-deftest uwumacs-registry-conflict-and-invalid-replacement-are-atomic ()
  (uwumacs-registry-test-with-registry
    (uwumacs-register-integration 'one :leader-bindings '(("z" ignore "One")))
    (uwumacs-enable-integration 'one)
    (let ((map uwumacs--buffer-leader-map) (registry uwumacs--registry))
      (should-error (uwumacs-register-integration 'one :leader-bindings '(("f f" forward-char "Conflict"))))
      (should (eq map uwumacs--buffer-leader-map))
      (should (equal registry uwumacs--registry)))
    (uwumacs-register-integration 'two :leader-bindings '(("z" forward-char "Two")))
    (let ((map uwumacs--buffer-leader-map))
      (let ((err (should-error (uwumacs-enable-integration 'two))))
        (should (string-match-p "one" (error-message-string err)))
        (should (string-match-p "two" (error-message-string err))))
      (should (eq map uwumacs--buffer-leader-map))
      (should-not (memq 'two uwumacs-integrations))
      (should (string-match-p "two" (or uwumacs--registry-diagnostic ""))))))

(ert-deftest uwumacs-registry-override-hook-and-failed-setup-cleanup ()
  (uwumacs-registry-test-with-registry
    (let ((cleanups 0) (hooks 0))
      (add-hook 'uwumacs-after-integration-hook
                (lambda (id) (cl-incf hooks)
                  (when (eq id 'broken) (error "override failed"))
                  (keymap-set uwumacs-user-leader-map "z" #'backward-char)))
      (uwumacs-register-integration 'good :leader-bindings '(("z" ignore "Good")))
      (uwumacs-enable-integration 'good)
      (should (eq 'backward-char (keymap-lookup uwumacs--buffer-leader-map "z")))
      (uwumacs-register-integration 'broken :setup (lambda () (lambda () (cl-incf cleanups))))
      (should (eq 'failed (uwumacs-enable-integration 'broken)))
      (should (= cleanups 1))
      (uwumacs-refresh)
      (should (= hooks 2))
      (uwumacs-register-integration 'raises :setup (lambda () (error "setup failed")))
      (should (eq 'failed (uwumacs-enable-integration 'raises)))
      (uwumacs-doctor)
      (with-current-buffer "*UwUmacs Doctor*"
        (should (string-match-p "setup failed" (buffer-string)))))))

(ert-deftest uwumacs-registry-pending-mode-leader-is-global ()
  (uwumacs-registry-test-with-registry
    (let ((setups 0))
      (uwumacs-register-integration 'mode :modes '(uwumacs-registry-parent-mode)
        :leader-bindings '(("z" ignore "Open"))
        :setup (lambda () (cl-incf setups) nil))
      (should (eq 'pending (uwumacs-enable-integration 'mode)))
      (with-temp-buffer
        (text-mode)
        (should (eq 'ignore (key-binding (kbd "C-c C-SPC z"))))
        (should (= setups 0)))
      (with-temp-buffer
        (uwumacs-registry-child-mode)
        (should (= setups 1)))
      (with-temp-buffer (text-mode) (uwumacs-refresh) (should (= setups 1)))
      (uwumacs-register-integration 'other :modes '(text-mode)
        :leader-bindings '(("z" forward-char "Other")))
      (should-error (uwumacs-enable-integration 'other)))))

