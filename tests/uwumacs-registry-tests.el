(ert-deftest uwumacs-registry-failed-replacement-retires-dependent-effects ()
  (uwumacs-registry-test-with-registry
    (let ((events nil))
      (uwumacs-register-integration 'base :setup (lambda () (push 'base-start events) (lambda () (push 'base-stop events))))
      (uwumacs-register-integration 'child :requires '(base)
        :setup (lambda () (push 'child-start events) (lambda () (push 'child-stop events))))
      (uwumacs-enable-integration 'base)
      (uwumacs-enable-integration 'child)
      (uwumacs-register-integration 'base :setup (lambda () (error "new setup failed")))
      (should (eq 'failed (uwumacs-registry-test-status 'base)))
      (should (eq 'unavailable (uwumacs-registry-test-status 'child)))
      (should (memq 'child-stop events))
      (should (= 1 (cl-count 'base-stop events)))
      (should (= 1 (cl-count 'child-stop events))))))

