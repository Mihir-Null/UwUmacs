;;
;; The token is cached in ~/.emacs.d/.cache/copilot-chat/ so login persists.
;;
;; "Codex" in 2025 = gpt-5-codex available through Copilot — it's just a model
;; name on this backend, not a separate service.

;; (after! gptel
